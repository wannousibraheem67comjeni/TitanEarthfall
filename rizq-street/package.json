{
  "name": "rizq-street",
  "private": true,
  "version": "0.1.0",
  "description": "شارع الرزق: a 3D Arabic street game about earning UAE dirhams through honest work, with voice conversations with its characters.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource/lalezar": "5.3.0",
    "@fontsource/readex-pro": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.12"
  }
}
