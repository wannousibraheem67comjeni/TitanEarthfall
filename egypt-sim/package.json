{
  "name": "egypt-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time 3D interactive simulation of Egypt (27 governorates, cities, landmarks, terrain) built on Three.js.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bake:gis": "node tools/bake-gis.mjs",
    "fetch:osm": "node tools/fetch-osm.mjs"
  },
  "dependencies": {
    "earcut": "3.2.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
