<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Authoritative race lobby. Compiles the same engine-independent runner core the Unity client uses. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TitanEarthfall.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Runner/Core/**/*.cs" LinkBase="RunnerCore" />
  </ItemGroup>
</Project>
