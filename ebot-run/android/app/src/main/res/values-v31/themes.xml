<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ebot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ebot_navy</item>
        <item name="android:colorPrimary">@color/ebot_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowSplashScreenBackground">@color/ebot_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
