# Copy to keystore.properties (never commit the real file or the .jks).
# Create a key:  keytool -genkeypair -v -keystore keystore/hopinet-upload.jks -storetype PKCS12 -alias hopinet-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/hopinet-upload.jks
storePassword=CHANGE_ME
keyAlias=hopinet-upload
keyPassword=CHANGE_ME
